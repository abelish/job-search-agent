# Anthropic API key, used by the Claude client wrapper for scoring, tailoring, and prep generation
ANTHROPIC_API_KEY=

# Gmail API credentials, used to parse LinkedIn/Indeed job alert emails
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional: comma separated list of company board tokens/slugs to track
# Example: GREENHOUSE_BOARDS=stripe,anthropic,figma
GREENHOUSE_BOARDS=
LEVER_BOARDS=
ASHBY_BOARDS=
SMARTRECRUITERS_COMPANIES=

# Optional: Bundesagentur für Arbeit (German federal jobs API)
# To find your API key: open https://www.arbeitsagentur.de/jobsuche in Chrome,
# open DevTools > Network, search for any job, and copy the X-API-Key request header.
ARBEITSAGENTUR_LOCATION=
ARBEITSAGENTUR_API_KEY=

# Monthly Claude API spend cap in USD (used for the dashboard budget widget)
MONTHLY_BUDGET_USD=50
